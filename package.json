{
  "name": "milanes-script",
  "displayName": "MilanéScript",
  "description": "Poch ciàcer e cumpila.",
  "version": "0.1.0",
  "publisher": "bigjoe81",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "main": "./extension.cjs",
  "bin": {
    "uec": "./uec.cjs"
  },
  "scripts": {
    "test": "node --test",
    "vsix": "vsce package"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bigjoe81/milanes-script.git"
  },
  "activationEvents": [
    "onLanguage:milanescript"
  ],
  "contributes": {
    "languages": [
      {
        "id": "milanescript",
        "aliases": [
          "MilanéScript"
        ],
        "extensions": [
          ".ue"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "milanescript",
        "scopeName": "source.milanescript",
        "path": "./syntax.json"
      }
    ]
  }
}